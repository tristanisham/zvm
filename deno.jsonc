{
  "tasks": {
    "build": "deno run -A build.ts",
    "clean": "rm -r build",
    "pkg": "deno run -A .github/scripts/pkg.ts",
    "pkg:check": "deno run -A .github/scripts/pkg.ts --check",
    "release": "deno task test:pkg && deno task test:build && deno task pkg:check && deno task build",
    "test:build": "deno cache build.ts && deno test -A build_test.ts",
    "test:pkg": "deno test -A .github/scripts/pkg_test.ts",
    "test:star-history": "deno test -A .github/scripts/star-history_test.ts",
    "star-history": "deno run -A .github/scripts/star-history.ts"
  },
  "imports": {
    "@std/cli": "jsr:@std/cli@^1.0.28",
    "@std/path": "jsr:@std/path@^0.219.1",
    "@std/tar": "jsr:@std/tar@^0.1.10",
    "@zip-js/zip-js": "jsr:@zip-js/zip-js@^2.8.24"
  }
}
